{
  "xcaf-agent": {
    "prefix": ["agent", "kind: agent"],
    "description": "Create an xcaffold agent manifest",
    "scope": "yaml",
    "body": [
      "---",
      "kind: agent",
      "version: \"1.0\"",
      "name: ${1:agent-name}",
      "description: \"${2:Brief description of the agent's role}\"",
      "model: ${3|sonnet,opus,haiku|}",
      "tools: [${4:Read, Write, Edit, Bash, Glob, Grep}]",
      "---",
      "${0}"
    ]
  },
  "xcaf-skill": {
    "prefix": ["skill", "kind: skill"],
    "description": "Create an xcaffold skill manifest",
    "scope": "yaml",
    "body": [
      "---",
      "kind: skill",
      "version: \"1.0\"",
      "name: ${1:skill-name}",
      "description: \"${2:Brief description of what the skill does}\"",
      "allowed-tools: [${3:Read, Write, Edit, Bash}]",
      "---",
      "${0}"
    ]
  },
  "xcaf-rule": {
    "prefix": ["rule", "kind: rule"],
    "description": "Create an xcaffold rule manifest",
    "scope": "yaml",
    "body": [
      "---",
      "kind: rule",
      "version: \"1.0\"",
      "name: ${1:rule-name}",
      "description: \"${2:Brief description of the rule's guardrail}\"",
      "always-apply: ${3|true,false|}",
      "---",
      "${0}"
    ]
  },
  "xcaf-workflow": {
    "prefix": ["workflow", "kind: workflow"],
    "description": "Create an xcaffold workflow manifest",
    "scope": "yaml",
    "body": [
      "---",
      "kind: workflow",
      "version: \"1.0\"",
      "api-version: workflow/v1",
      "name: ${1:workflow-name}",
      "description: \"${2:Brief description of the workflow goal}\"",
      "---",
      "${0}"
    ]
  },
  "xcaf-mcp": {
    "prefix": ["mcp", "kind: mcp"],
    "description": "Create an xcaffold MCP server manifest",
    "scope": "yaml",
    "body": [
      "kind: mcp",
      "version: \"1.0\"",
      "name: ${1:server-name}",
      "description: \"${2:Brief description of the MCP server}\"",
      "command: ${3:npx}",
      "args: [${4:@modelcontextprotocol/server}]",
      "${0}"
    ]
  }
}
