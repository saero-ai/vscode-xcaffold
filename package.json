{
  "name": "vscode-xcaffold",
  "displayName": "xcaffold",
  "description": "xcaffold .xcf manifest authoring — schema validation, autocomplete, and CLI commands",
  "version": "0.1.0",
  "publisher": "saero-ai",
  "icon": "logo.png",
  "license": "MIT",
  "xcaffold": {
    "minCliVersion": "0.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saero-ai/vscode-xcaffold.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "workspaceContains:**/*.xcf"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "yaml.schemas": {
      "./schemas/xcaffold-schema.json": "*.xcf"
    },
    "commands": [
      {
        "command": "xcaffold.apply",
        "title": "xcaffold: Apply Manifest",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.validate",
        "title": "xcaffold: Validate Manifest",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.status",
        "title": "xcaffold: Show Project Status",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.list",
        "title": "xcaffold: List Resources",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.graph",
        "title": "xcaffold: Show Resource Graph",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.import",
        "title": "xcaffold: Import from Providers",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.refreshExplorer",
        "title": "Refresh Explorer",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xcaffold",
          "title": "xcaffold",
          "icon": "logo.svg"
        }
      ]
    },
    "views": {
      "xcaffold": [
        {
          "id": "xcaffoldExplorer",
          "name": "Resource Explorer"
        }
      ]
    },
    "configuration": {
      "title": "xcaffold",
      "properties": {
        "xcaffold.binaryPath": {
          "type": "string",
          "default": "xcaffold",
          "description": "Path to the xcaffold binary. Defaults to 'xcaffold' on PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "compile:production": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npx ts-node src/test/runTests.ts",
    "pretest": "npm run typecheck"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/saero-ai/vscode-xcaffold/issues"
  },
  "homepage": "https://github.com/saero-ai/vscode-xcaffold#readme",
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/mocha": "^10.0.10",
    "@types/mock-require": "^3.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "d3": "^7.9.0",
    "esbuild": "^0.28.0",
    "mocha": "^11.7.5",
    "mock-require": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
