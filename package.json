{
  "name": "vscode-xcaffold",
  "displayName": "xcaffold",
  "description": "xcaffold .xcaf manifest authoring — schema validation, autocomplete, and CLI commands",
  "version": "0.2.0",
  "publisher": "saero-ai",
  "icon": "logo.png",
  "license": "MIT",
  "xcaffold": {
    "minCliVersion": "0.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saero-ai/vscode-xcaffold.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:xcaf",
    "workspaceContains:**/*.xcaf"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xcaf",
        "extensions": [
          ".xcaf"
        ],
        "aliases": [
          "xcaffold",
          "xcaf"
        ],
        "icon": {
          "light": "./icons/xcaf-light.svg",
          "dark": "./icons/xcaf-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "xcaf",
        "scopeName": "source.xcaf",
        "path": "./syntaxes/xcaf.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "xcaffold-icons",
        "label": "xcaffold Icons",
        "path": "./fileicons/xcaffold-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "xcaffold.apply",
        "title": "xcaffold: Apply Manifest",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.validate",
        "title": "xcaffold: Validate Manifest",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.status",
        "title": "xcaffold: Show Project Status",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.list",
        "title": "xcaffold: List Resources",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.graph",
        "title": "xcaffold: Show Resource Graph",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.import",
        "title": "xcaffold: Import from Providers",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.refreshExplorer",
        "title": "Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "xcaffold.validateFile",
        "title": "xcaffold: Validate Active File",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.initWizard",
        "title": "xcaffold: Initialize Project (Wizard)",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.importPicker",
        "title": "xcaffold: Import from Providers (Picker)",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.diff",
        "title": "xcaffold: Diff Preview",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.fidelity",
        "title": "xcaffold: Fidelity Report",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.statusDash",
        "title": "xcaffold: Status Dashboard",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.schemaViewer",
        "title": "xcaffold: Schema Viewer",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.openResource",
        "title": "xcaffold: Open File",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.findReferences",
        "title": "xcaffold: Find References",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.newResource",
        "title": "xcaffold: New Resource...",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.deleteResource",
        "title": "xcaffold: Delete Resource",
        "category": "xcaffold"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xcaffold",
          "title": "xcaffold",
          "icon": "logo.svg"
        }
      ]
    },
    "views": {
      "xcaffold": [
        {
          "id": "xcaffoldStatusDash",
          "name": "Status",
          "type": "webview"
        },
        {
          "id": "xcaffoldExplorer",
          "name": "Resource Explorer"
        },
        {
          "id": "xcaffoldActions",
          "name": "Actions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "xcaffoldActions",
        "contents": "**Compile**\n[Apply to All Providers](command:xcaffold.apply)\n[Apply to Target](command:xcaffold.apply)\n\n**Inspect**\n[Validate Project](command:xcaffold.validate)\n[Show Resource Graph](command:xcaffold.graph)\n[Status Dashboard](command:xcaffold.statusDash)\n[Fidelity Report](command:xcaffold.fidelity)\n\n**Create**\n[Init Project (Wizard)](command:xcaffold.initWizard)\n[Import from Providers](command:xcaffold.importPicker)\n\n**Reference**\n[Schema Viewer](command:xcaffold.schemaViewer)\n[Preview Changes (Diff)](command:xcaffold.diff)"
      }
    ],
    "configuration": {
      "title": "xcaffold",
      "properties": {
        "xcaffold.binaryPath": {
          "type": "string",
          "default": "xcaffold",
          "description": "Path to the xcaffold binary. Defaults to 'xcaffold' on PATH."
        }
      }
    },
    "snippets": [
      {
        "language": "xcaf",
        "path": "./snippets/xcaf.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xcaffold.validateFile",
          "when": "resourceExtname == .xcaf",
          "group": "xcaffold@1"
        }
      ],
      "view/item/context": [
        {
          "command": "xcaffold.openResource",
          "when": "viewItem == resource-item",
          "group": "navigation@1"
        },
        {
          "command": "xcaffold.validate",
          "when": "viewItem == resource-item",
          "group": "xcaffold@1"
        },
        {
          "command": "xcaffold.apply",
          "when": "viewItem == resource-item",
          "group": "xcaffold@2"
        },
        {
          "command": "xcaffold.findReferences",
          "when": "viewItem == resource-item",
          "group": "xcaffold@3"
        },
        {
          "command": "xcaffold.deleteResource",
          "when": "viewItem == resource-item",
          "group": "xcaffold@9"
        },
        {
          "command": "xcaffold.newResource",
          "when": "viewItem == kind-group",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "xcaffold.refreshExplorer",
          "when": "view == xcaffoldExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "compile:production": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npx ts-node src/test/runTests.ts",
    "pretest": "npm run typecheck"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/saero-ai/vscode-xcaffold/issues"
  },
  "homepage": "https://github.com/saero-ai/vscode-xcaffold#readme",
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/mocha": "^10.0.10",
    "@types/mock-require": "^3.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "d3": "^7.9.0",
    "esbuild": "^0.28.0",
    "mocha": "^11.7.5",
    "mock-require": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
