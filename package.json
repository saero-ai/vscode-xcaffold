{
  "name": "vscode-xcaffold",
  "displayName": "xcaffold",
  "description": "xcaffold .xcf manifest authoring — schema validation, autocomplete, and CLI commands",
  "version": "0.1.0",
  "publisher": "saero-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saero-ai/vscode-xcaffold.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "workspaceContains:**/*.xcf"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "yaml.schemas": {
      "./schemas/xcaffold-schema.json": "*.xcf"
    },
    "configuration": {
      "title": "xcaffold",
      "properties": {
        "xcaffold.binaryPath": {
          "type": "string",
          "default": "xcaffold",
          "description": "Path to the xcaffold binary. Defaults to 'xcaffold' on PATH."
        }
      }
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/saero-ai/vscode-xcaffold/issues"
  },
  "homepage": "https://github.com/saero-ai/vscode-xcaffold#readme",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/mock-require": "^3.0.0",
    "@types/vscode": "^1.118.0",
    "mocha": "^11.7.5",
    "mock-require": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
