{
  "name": "vscode-xcaffold",
  "displayName": "xcaffold",
  "description": "xcaffold .xcaf manifest authoring — schema validation, autocomplete, and CLI commands",
  "version": "0.6.0",
  "publisher": "saero-ai",
  "icon": "logo.png",
  "license": "Apache-2.0",
  "xcaffold": {
    "minCliVersion": "0.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saero-ai/vscode-xcaffold.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:xcaf",
    "workspaceContains:**/*.xcaf"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xcaf",
        "extensions": [
          ".xcaf"
        ],
        "aliases": [
          "xcaffold",
          "xcaf"
        ],
        "icon": {
          "light": "./icons/xcaf-light.svg",
          "dark": "./icons/xcaf-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "xcaf",
        "scopeName": "source.xcaf",
        "path": "./syntaxes/xcaf.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "xcaffold-icons",
        "label": "xcaffold Icons",
        "path": "./fileicons/xcaffold-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "xcaffold.apply",
        "title": "Apply Manifest",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.validate",
        "title": "Validate Manifest",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.status",
        "title": "Show Project Status",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.list",
        "title": "List Resources",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.graph",
        "title": "Show Resource Graph",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.import",
        "title": "Import from Providers",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.refreshExplorer",
        "title": "Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "xcaffold.validateFile",
        "title": "Validate Active File",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.initWizard",
        "title": "Initialize Project (Wizard)",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.importPicker",
        "title": "Import from Providers (Picker)",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.diff",
        "title": "Diff Preview",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.statusDash",
        "title": "Status Dashboard",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.schemaViewer",
        "title": "Schema Viewer",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.openResource",
        "title": "Open File",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.findReferences",
        "title": "Find References",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.newResource",
        "title": "New Resource...",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.deleteResource",
        "title": "Delete Resource",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.refreshDashboard",
        "title": "Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "xcaffold.registryList",
        "title": "Registry List",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.registryAdd",
        "title": "Registry Add",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.registryRemove",
        "title": "Registry Remove",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.registryPrune",
        "title": "Registry Prune",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.registryInfo",
        "title": "Registry Info",
        "category": "xcaffold"
      },
      {
        "command": "xcaffold.toggleGlobalScope",
        "title": "Toggle Global Scope",
        "category": "xcaffold"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xcaffold",
          "title": "xcaffold",
          "icon": "logo.svg"
        }
      ]
    },
    "views": {
      "xcaffold": [
        {
          "id": "xcaffoldStatusDash",
          "name": "Status",
          "type": "webview"
        },
        {
          "id": "xcaffoldExplorer",
          "name": "Resource Explorer"
        },
        {
          "id": "xcaffoldMiniGraph",
          "name": "Harness Graph",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "xcaffold",
      "properties": {
        "xcaffold.binaryPath": {
          "type": "string",
          "default": "xcaffold",
          "description": "Path to the xcaffold binary. Defaults to 'xcaffold' on PATH."
        },
        "xcaffold.globalScope": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, xcaffold commands operate on the user-wide global config (~/.xcaffold/xcaf/) instead of the workspace project."
        }
      }
    },
    "snippets": [
      {
        "language": "xcaf",
        "path": "./snippets/xcaf.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xcaffold.validateFile",
          "when": "resourceExtname == .xcaf",
          "group": "xcaffold@1"
        }
      ],
      "view/item/context": [
        {
          "command": "xcaffold.openResource",
          "when": "viewItem == resource || viewItem == override || viewItem == artifact-file",
          "group": "navigation@1"
        },
        {
          "command": "xcaffold.validate",
          "when": "viewItem == resource",
          "group": "xcaffold@1"
        },
        {
          "command": "xcaffold.apply",
          "when": "viewItem == resource",
          "group": "xcaffold@2"
        },
        {
          "command": "xcaffold.findReferences",
          "when": "viewItem == resource",
          "group": "xcaffold@3"
        },
        {
          "command": "xcaffold.deleteResource",
          "when": "viewItem == resource",
          "group": "xcaffold@9"
        },
        {
          "command": "xcaffold.newResource",
          "when": "viewItem == kind-group",
          "group": "navigation@1"
        },
        {
          "command": "xcaffold.registryInfo",
          "when": "viewItem == registry-entry",
          "group": "xcaffold@1"
        },
        {
          "command": "xcaffold.registryRemove",
          "when": "viewItem == registry-entry",
          "group": "xcaffold@9"
        }
      ],
      "view/title": [
        {
          "command": "xcaffold.refreshExplorer",
          "when": "view == xcaffoldExplorer",
          "group": "navigation"
        },
        {
          "command": "xcaffold.refreshDashboard",
          "when": "view == xcaffoldStatusDash",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "xcaffold.apply",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "resourceExtname == .xcaf"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "compile:production": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npx ts-node src/test/runTests.ts",
    "pretest": "npm run typecheck",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "xcaf",
    "agent-configuration",
    "CLAUDE.md",
    "cursorrules",
    "ai-agent",
    "config-management"
  ],
  "author": "",
  "bugs": {
    "url": "https://github.com/saero-ai/vscode-xcaffold/issues"
  },
  "homepage": "https://github.com/saero-ai/vscode-xcaffold#readme",
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/mocha": "^10.0.10",
    "@types/mock-require": "^3.0.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vscode/vsce": "^3.9.2",
    "d3": "^7.9.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "mocha": "^11.7.5",
    "mock-require": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
